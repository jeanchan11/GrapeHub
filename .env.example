# Variáveis para o Banco de Dados (Neon)
DATABASE_URL=
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Variáveis para o Frontend (Firebase)
# IMPORTANTE: No painel da Hostinger, adicione estas variáveis exatamente com estes nomes
VITE    _FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Firebase Admin SDK (Service Account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# API Keys
ANTHROPIC_API_KEY=
ASAAS_API_KEY=

# Api4Com
Token=
dominio=
ramal=
senha-ramal=

# Assinatura eletrônica de contrato (ZapSign)
# Token da API em app.zapsign.com.br → Configurações → Integrações → API
ZAPSIGN_API_TOKEN=
# Contra-assinatura automática da Grape (opcional — sem isto o contrato sai com
# um signatário só). O user_token sai do perfil do usuário no ZapSign, em
# "assinar via API"; o e-mail precisa ser o MESMO desse usuário.
ZAPSIGN_USER_TOKEN=
ZAPSIGN_SIGNER_EMAIL=
ZAPSIGN_SIGNER_NAME=Grape Mídia LTDA
