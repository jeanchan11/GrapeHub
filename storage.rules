rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if true;
    }
    match /projects/{projectId}/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if true;
    }
    // Vídeo-aulas da Central de Treinamentos. A reprodução usa a URL com token
    // devolvida por getDownloadURL(), então exigir login no read não atrapalha o player.
    match /cursos/{courseId}/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }
    // Fotos de avatar e amostras de voz do Estúdio de Vídeo.
    match /estudio/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }
    match /optimizations/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if true;
    }
  }
}
